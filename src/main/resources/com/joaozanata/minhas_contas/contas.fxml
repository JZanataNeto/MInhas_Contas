<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.joaozanata.minhas_contas.ContasController">
   <children>
      <Label text="Minhas Contas">
         <font>
            <Font size="36.0" />
         </font>
         <VBox.margin>
            <Insets left="50.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="20.0" top="10.0" />
         </padding>
      </Label>
      <TableView fx:id="tblContas" prefHeight="380.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="clConsc" prefWidth="200.0" text="Concessionária" />
          <TableColumn fx:id="clDesc" prefWidth="200.0" text="Descrição" />
            <TableColumn fx:id="clVenc" prefWidth="200.0" text="Data Vencimento" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="40.0">
         <children>
            <TextField fx:id="txtConsc" />
            <TextField fx:id="txtDesc" />
            <DatePicker fx:id="dpVencimento" />
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="40.0">
         <children>
            <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#salvar" text="Salvar" />
            <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#atualizar" text="Atualizar" />
            <Button fx:id="btnApagar" mnemonicParsing="false" onAction="#apagar" text="Apagar" />
            <Button fx:id="btnLimpart" mnemonicParsing="false" onAction="#limpar" text="Limpar" />
         </children>
         <cursor>
            <Cursor fx:constant="DEFAULT" />
         </cursor>
         <effect>
            <Blend />
         </effect>
      </HBox>
   </children>
</VBox>
